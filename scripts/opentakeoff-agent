#!/usr/bin/env python3
"""Call the live OpenTakeoff canvas: opentakeoff-agent TOOL '{"arg":"value"}'."""
import os
import json
from pathlib import Path
import sys
import urllib.request
import urllib.error

try:
    token = (Path.home() / '.local/state/opentakeoff/agent-token').read_text().strip()
    name = sys.argv[1] if len(sys.argv) > 1 else 'workspace_state'
    args = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}
    endpoint = 'status' if name == 'status' else 'call'
    data = None if endpoint == 'status' else json.dumps({'name': name, 'args': args}).encode()
    port = int(os.environ.get('OPENTAKEOFF_LOCAL_AGENT_PORT', '5188'))
    if not 1024 <= port <= 65535: raise ValueError('Invalid pinned loopback port')
    request = urllib.request.Request(f'http://127.0.0.1:{port}/__agent/' + endpoint, data=data,
        headers={'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json'})
    with urllib.request.urlopen(request, timeout=65) as response:
        print(json.dumps(json.load(response), indent=2))
except urllib.error.HTTPError as error:
    print(error.read().decode(), file=sys.stderr)
    sys.exit(1)
except Exception as error:
    print(str(error), file=sys.stderr)
    sys.exit(1)
